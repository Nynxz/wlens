[Desktop Entry]
Type=Application
Name=wlens
GenericName=Image Viewer
Comment=View images and videos, configured with Lua
Exec=wlens -S %F
Icon=wlens
Terminal=false
Categories=Graphics;Viewer;
Keywords=image;photo;picture;viewer;gallery;
